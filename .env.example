# Conexión a Postgres (Vercel Postgres / Neon).
# En Vercel se crea automáticamente al conectar la base de datos al proyecto.
DATABASE_URL="postgresql://usuario:password@host/xtellaris?sslmode=require"

# Secreto para firmar las sesiones JWT de NextAuth.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-este-valor"

# URL pública de la app. En local: http://localhost:3000
# En Vercel no es necesario definirla (se infiere automáticamente).
NEXTAUTH_URL="http://localhost:3000"
