// Xtellaris — esquema multi-tenant.
// Toda tabla de datos de negocio lleva businessId; las queries SIEMPRE
// se filtran por businessId en la capa de servicios (src/server/services).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  // Unidades de medida habilitadas para este negocio (personalizables).
  units     String[] @default(["unidad", "libra", "kilo", "litro", "arroba", "cubeta", "docena"])
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  users        User[]
  categories   Category[]
  products     Product[]
  suppliers    Supplier[]
  sales        Sale[]
  stockEntries StockEntry[]
}

enum Role {
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  sales Sale[]
}

model Category {
  id         String   @id @default(cuid())
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([businessId, name])
}

model Product {
  id            String    @id @default(cuid())
  name          String
  barcode       String?
  // Precios en pesos colombianos, sin decimales.
  purchasePrice Int
  salePrice     Int
  // Stock con decimales para unidades fraccionables (libra, kilo, litro).
  stock         Decimal   @default(0) @db.Decimal(12, 2)
  minStock      Decimal   @default(0) @db.Decimal(12, 2)
  unit          String    @default("unidad")
  imageUrl      String?
  active        Boolean   @default(true)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  saleItems  SaleItem[]
  entryItems StockEntryItem[]

  @@index([businessId, active])
  @@index([businessId, categoryId])
}

model Supplier {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  notes      String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  products     Product[]
  stockEntries StockEntry[]

  @@index([businessId])
}

model Sale {
  id         String   @id @default(cuid())
  total      Int
  paidWith   Int?
  change     Int?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  items SaleItem[]

  @@index([businessId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal @db.Decimal(12, 2)
  // Copia de precios al momento de la venta, para reportes de margen históricos.
  unitPrice Int
  unitCost  Int
  subtotal  Int

  @@index([productId])
}

model StockEntry {
  id         String    @id @default(cuid())
  totalCost  Int
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  items StockEntryItem[]

  @@index([businessId, createdAt])
}

model StockEntryItem {
  id        String     @id @default(cuid())
  entryId   String
  entry     StockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal    @db.Decimal(12, 2)
  unitCost  Int

  @@index([productId])
}
